# Variables del compose plunk-mcp en Dokploy. Los PEGAR_EN_DOKPLOY los pega la persona.
MCP_DOMAIN=envio-mcp.example.com
PLUNK_API_URL=https://envio-api.example.com
# Usuarios de GitHub que pueden iniciar sesión, separados por comas
GITHUB_ALLOWED_USERS=usuario-de-github
PLUNK_MCP_API_KEY=PEGAR_EN_DOKPLOY
GITHUB_CLIENT_ID=PEGAR_EN_DOKPLOY
GITHUB_CLIENT_SECRET=PEGAR_EN_DOKPLOY
# claude.ai no puede mostrar la confirmación de Plunk: con false, no se pueden enviar campañas ni emails a varias personas
PLUNK_ALLOW_UNCONFIRMED_SENDS=false
# true: solo herramientas de lectura
PLUNK_READ_ONLY=false
