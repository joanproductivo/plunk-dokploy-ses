# Variables para la pestaña Environment del compose de Plunk en Dokploy.
# Genera una copia rellenada con: python3 scripts/render_env.py --help
# Las claves de AWS las pega la persona directamente en Dokploy, nunca en el chat.

# Secretos internos (generados por render_env.py)
DB_PASSWORD=
JWT_SECRET=

# Dominios (subdominios de un solo nivel: el certificado gratuito de Cloudflare no cubre más)
DASHBOARD_DOMAIN=envio.example.com
API_DOMAIN=envio-api.example.com
LANDING_DOMAIN=landing.plunk.internal
WIKI_DOMAIN=docs.plunk.internal
LANDING_URI=https://envio.example.com
WIKI_URI=https://envio.example.com
USE_HTTPS=true

# AWS SES (región donde están la identidad, los configuration sets y el topic SNS)
AWS_SES_REGION=eu-north-1
AWS_SES_ACCESS_KEY_ID=PEGAR_EN_DOKPLOY
AWS_SES_SECRET_ACCESS_KEY=PEGAR_EN_DOKPLOY
SES_CONFIGURATION_SET=plunk-configuration-set
SES_CONFIGURATION_SET_NO_TRACKING=plunk-no-tracking-configuration-set

# Imágenes del editor: bucket de Cloudflare R2 (u otro S3) con lectura pública en el dominio de files.
# Las claves del token las pega la persona en Dokploy; vacías, Plunk arranca sin subidas de imágenes.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=<bucket>
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PUBLIC_URL=https://envio-files.example.com

# Acceso
DISABLE_SIGNUPS=false
AUTO_PROJECT_DISABLE=false
SHOW_SPONSOR=false

# Opcionales (descomentar cuando toque)
# PLUNK_API_KEY=sk_...
# PLUNK_FROM_ADDRESS=no-reply@news.example.com
# RATE_LIMIT_ENABLED=true
